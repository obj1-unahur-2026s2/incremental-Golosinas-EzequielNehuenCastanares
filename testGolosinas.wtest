describe "Grupo de test de Chocolatin" {
    test "se verifica que el precio de Chocolatin con peso inicial 40 es 20"{
        const obleaTest = new Chocolatin(pesoInicial=40)
        assert.equals(20, obleaTest.precio())
    }

    test "se verifica que el precio de Chocolatin con peso inicial 100 es 50"{
        const obleaTest = new Chocolatin(pesoInicial=100)
        assert.equals(50, obleaTest.precio())
    }

    test "se verifica que el peso es 100"{
        const obleaTest = new Chocolatin(pesoInicial=100)
        assert.equals(100, obleaTest.peso())
    }

    test "se verifica que su gusto es chocolate"{
        const obleaTest = new Chocolatin(pesoInicial=40)
        assert.equals(chocolate, obleaTest.sabor())
    }

    test "se verifica que no es libre de gluten"{
        const obleaTest = new Chocolatin(pesoInicial=40)
        assert.notThat(obleaTest.esLibreDeGluten())
    }
}

describe "Grupo de test de Pastilla Tutti-frutti" {
    test "se verifica que el precio de PastillaTuttiFrutti es 7 cuando es libre de gluten"{
        const pastillaTuttiFruttiTest = new PastillaTuttiFrutti(esLibreDeGluten=true)
        assert.equals(7, pastillaTuttiFruttiTest.precio())
    }

    test "se verifica que el precio de PastillaTuttiFrutti es 10 cuando no es libre de gluten"{
        const pastillaTuttiFruttiTest = new PastillaTuttiFrutti(esLibreDeGluten=false)
        assert.equals(10, pastillaTuttiFruttiTest.precio())
    }

    test "se verifica que el peso es 5"{
        const pastillaTuttiFruttiTest = new PastillaTuttiFrutti(esLibreDeGluten=true)
        assert.equals(5, pastillaTuttiFruttiTest.peso())
    }

    test "se verifica que su gusto es chocolate"{
        const pastillaTuttiFruttiTest = new PastillaTuttiFrutti(esLibreDeGluten=true)
        assert.equals(chocolate, pastillaTuttiFruttiTest.sabor())
    }

    test "se verifica que es libre de gluten"{
        const pastillaTuttiFruttiTest = new PastillaTuttiFrutti(esLibreDeGluten=true)
        assert.that(pastillaTuttiFruttiTest.esLibreDeGluten())
    }

    test "se verifica que no es libre de gluten"{
        const pastillaTuttiFruttiTest = new PastillaTuttiFrutti(esLibreDeGluten=false)
        assert.notThat(pastillaTuttiFruttiTest.esLibreDeGluten())
    }
}

describe "Grupo de test de Golosinabaniada golosina base PastillaTuttiFrutti" {
    test "Se verifica que el precio de GolosinaBaniada con golosina base PastillaTuttiFrutti con gluten es 12"{
        const pastillaTuttiFruttiTest = new PastillaTuttiFrutti(esLibreDeGluten=false)
        const golosinaBaniadaTest = new GolosinaBaniada(golosinaBase=pastillaTuttiFruttiTest)
        assert.equals(12, golosinaBaniadaTest.precio())
    }

    test "Se verifica que el precio de GolosinaBaniada con golosina base PastillaTuttiFrutti libre de gluten es 9"{
        const pastillaTuttiFruttiTest = new PastillaTuttiFrutti(esLibreDeGluten=true)
        const golosinaBaniadaTest = new GolosinaBaniada(golosinaBase=pastillaTuttiFruttiTest)
        assert.equals(9, golosinaBaniadaTest.precio())
    }

    test "Se verifica que el peso de GolosinaBaniada con golosina base PastillaTuttiFrutti es 9"{
        const pastillaTuttiFruttiTest = new PastillaTuttiFrutti(esLibreDeGluten=false)
        const golosinaBaniadaTest = new GolosinaBaniada(golosinaBase=pastillaTuttiFruttiTest)
        assert.equals(9, golosinaBaniadaTest.peso())
    }

    test "se verifica que su gusto es frutilla"{
        const pastillaTuttiFruttiTest = new PastillaTuttiFrutti(esLibreDeGluten=false)
        const golosinaBaniadaTest = new GolosinaBaniada(golosinaBase=pastillaTuttiFruttiTest)
        assert.equals(chocolate, golosinaBaniadaTest.sabor())
    }

    test "se verifica que es libre de gluten cuando la pastillaTuttiFrutti lo es"{
        const pastillaTuttiFruttiTest = new PastillaTuttiFrutti(esLibreDeGluten=true)
        const golosinaBaniadaTest = new GolosinaBaniada(golosinaBase=pastillaTuttiFruttiTest)
        assert.that(golosinaBaniadaTest.esLibreDeGluten())
    }

    test "se verifica que no es libre de gluten cuando la pastillaTuttiFrutti no lo es"{
        const pastillaTuttiFruttiTest = new PastillaTuttiFrutti(esLibreDeGluten=false)
        const golosinaBaniadaTest = new GolosinaBaniada(golosinaBase=pastillaTuttiFruttiTest)
        assert.notThat(golosinaBaniadaTest.esLibreDeGluten())
    }
}

describe "Grupo de test de Golosinabaniada golosina base chocolatin" {
    test "Se verifica que el precio de GolosinaBaniada con golosina base chocolatin de peso inicial 15"{
        const chocolatinTest = new Chocolatin(pesoInicial=15)
        const golosinaBaniadaTest = new GolosinaBaniada(golosinaBase=chocolatinTest)
        assert.equals(9.5, golosinaBaniadaTest.precio())
    }

    test "Se verifica que el peso de GolosinaBaniada con golosina base chocolatin es 15"{
        const chocolatinTest = new Chocolatin(pesoInicial=15)
        const golosinaBaniadaTest = new GolosinaBaniada(golosinaBase=chocolatinTest)
        assert.equals(19, golosinaBaniadaTest.peso())
    }

    test "se verifica que su gusto es chocolate"{
        const chocolatinTest = new Chocolatin(pesoInicial=15)
        const golosinaBaniadaTest = new GolosinaBaniada(golosinaBase=chocolatinTest)
        assert.equals(chocolate, golosinaBaniadaTest.sabor())
    }

    test "se verifica que no es libre de gluten"{
        const chocolatinTest = new Chocolatin(pesoInicial=15)
        const golosinaBaniadaTest = new GolosinaBaniada(golosinaBase=chocolatinTest)
        assert.notThat(golosinaBaniadaTest.esLibreDeGluten())
    }
}

