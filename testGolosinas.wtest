import golosinas.*

describe "Grupo de test de Bombon" {
    test "se verifica que el precio de Bombon es 5"{
        const bombonTest = new Bombon()
        assert.equals(5, bombonTest.precio())
    }

    test "se verifica que el peso es 15"{
        const bombonTest = new Bombon()
        assert.equals(15, bombonTest.peso())
    }

    test "se verifica que su gusto es frutilla"{
        const bombonTest = new Bombon()
        assert.equals(frutilla, bombonTest.sabor())
    }

    test "se verifica que  es libre de gluten"{
        const bombonTest = new Bombon()
        assert.that(bombonTest.esLibreDeGluten())
    }

     test "se verifica que el peso de bombonTest después de recibir 2 mordiscos es de 7.8"{
        const bombonTest = new Bombon()
        bombonTest.recibirMordisco()
        bombonTest.recibirMordisco()
        assert.equals(7.8, bombonTest.peso())
    }
}


